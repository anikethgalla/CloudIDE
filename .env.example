# Project Breakout / Cloud IDE Configuration

# Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Google Gemini API Key (Required for Socratic AI & Rebuild Spec Generator)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Workspace storage path
WORKSPACES_DIR=../../workspaces

# Optional Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_ide?schema=public
REDIS_URL=redis://localhost:6379

# NextAuth / OAuth Configuration
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate_a_secure_random_string_here_32_chars_min

# Google OAuth Provider
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Provider
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
