# Project Breakout / Cloud IDE Configuration

# Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Google Gemini API Key (Required for Socratic AI & Rebuild Spec Generator)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Workspace storage path
WORKSPACES_DIR=../../workspaces

# Optional Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_ide?schema=public
